# PostgreSQL Veritabanı Bağlantısı
# Formatı: postgresql://KULLANICI_ADI:SIFRE@HOST:PORT/VERITABANI_ADI
PGUSER=postgres
PGHOST=localhost
PGPASSWORD=your_secure_password_here
PGDATABASE=uygunabak_db
PGPORT=5432

# Sunucu Portu
PORT=5050

# JWT Token Şifresi (güvenli rastgele bir string kullanın)
# Terminal'de çalıştırın: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# Ortam (development / production)
NODE_ENV=development

# Email Yapılandırması (gelecek özellikler için)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
